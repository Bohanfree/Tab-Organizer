{
  "manifest_version": 3,
  "name": "Atlas Tab Organizer",
  "description": "Auto-organize browser tabs into useful groups with optional AI instructions.",
  "version": "0.9.1",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Organize tabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "scripts": [
      "service-worker.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-organizer@bohanfree.github.io",
      "strict_min_version": "139.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
